
<style>
#solar-annual { padding: 0.5rem 0; font-family: var(--font-sans, -apple-system, sans-serif); }
canvas { display: block; width: 100%; border-radius: 10px; cursor: crosshair; }
#tooltip {
  position: absolute;
  background: rgba(10,18,40,0.92);
  color: #eef2ff;
  font-size: 12px;
  padding: 8px 12px;
  border-radius: 8px;
  pointer-events: none;
  display: none;
  line-height: 1.6;
  white-space: nowrap;
  z-index: 10;
}
.legend {
  display: flex;
  gap: 20px;
  margin-top: 10px;
  flex-wrap: wrap;
  justify-content: center;
}
.leg-item { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--color-text-secondary); }
.leg-swatch { width: 28px; height: 10px; border-radius: 3px; }
.leg-dash { width: 28px; height: 0; border-top: 1.5px dashed; }
</style>

<div id="solar-annual">
  <div style="position:relative;">
    <canvas id="ac"></canvas>
    <div id="tooltip"></div>
  </div>
  <div class="legend">
    <div class="leg-item"><div class="leg-swatch" style="background:#c8855a;"></div> Luz solar</div>
    <div class="leg-item"><div class="leg-swatch" style="background:#8a6a90;opacity:0.7"></div> Crepúsculo civil</div>
    <div class="leg-item"><div class="leg-swatch" style="background:#3a4a7a;opacity:0.7"></div> Crepúsculo náutico</div>
    <div class="leg-item"><div class="leg-swatch" style="background:#1a2340;"></div> Noche</div>
    <div class="leg-item"><div class="leg-dash" style="border-color:rgba(255,220,80,0.7);"></div> Mediodía solar</div>
  </div>
</div>

<script>
(function(){
  const LAT = 38.2669, LON = -0.6985;

  function toRad(d){ return d*Math.PI/180; }

  function getSolar(doy, lat, lon){
    const d = new Date(2025, 0, 1);
    d.setDate(doy);
    const JD = d.getTime()/86400000 + 2440587.5;
    const n = JD - 2451545.0;
    const L = (280.46 + 0.9856474*n) % 360;
    const g = toRad((357.528 + 0.9856003*n) % 360);
    const lambda = toRad(L + 1.915*Math.sin(g) + 0.02*Math.sin(2*g));
    const eps = toRad(23.439 - 0.0000004*n);
    const sinDec = Math.sin(eps)*Math.sin(lambda);
    const cosDec = Math.cos(Math.asin(sinDec));
    const sinLat = Math.sin(toRad(lat)), cosLat = Math.cos(toRad(lat));
    const EqT = (L - (Math.atan2(Math.cos(eps)*Math.sin(lambda), Math.cos(lambda))*180/Math.PI))/15;
    const noon = 12 - EqT - lon/15;
    function ha(ang){ return Math.acos(Math.max(-1,Math.min(1,(Math.cos(toRad(ang))-sinDec*sinLat)/(cosDec*cosLat))))*180/Math.PI; }
    return {
      noon,
      rise:      noon - ha(90.833)/15,
      set:       noon + ha(90.833)/15,
      dawnCivil: noon - ha(96)/15,
      duskCivil: noon + ha(96)/15,
      dawnNaut:  noon - ha(102)/15,
      duskNaut:  noon + ha(102)/15,
    };
  }

  function spainOffset(doy){
    const d = new Date(2025,0,1); d.setDate(doy);
    const m = d.getMonth()+1, day = d.getDate();
    if(m>3 && m<10) return 2;
    if(m===3 && day>=25) return 2;
    if(m===10 && day<25) return 2;
    return 1;
  }

  const DAYS = 365;
  const data = [];
  for(let i=1; i<=DAYS; i++){
    const off = spainOffset(i);
    const s = getSolar(i, LAT, LON);
    data.push({
      doy: i,
      rise:      s.rise      + off,
      set:       s.set       + off,
      noon:      s.noon      + off,
      dawnCivil: s.dawnCivil + off,
      duskCivil: s.duskCivil + off,
      dawnNaut:  s.dawnNaut  + off,
      duskNaut:  s.duskNaut  + off,
      offset: off
    });
  }

  const canvas = document.getElementById('ac');
  const ctx = canvas.getContext('2d');

  const MONTHS = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
  const MONTH_DOY = [1,32,60,91,121,152,182,213,244,274,305,335];

  function doyToDate(doy){
    const d = new Date(2025,0,1); d.setDate(doy);
    return d.toLocaleDateString('es-ES',{day:'numeric',month:'long'});
  }

  function fmt(h){
    const m = Math.round(h*60);
    return String(Math.floor(m/60)).padStart(2,'0')+':'+String(m%60).padStart(2,'0');
  }

  function fmtDur(h){
    const m = Math.round(h*60);
    return Math.floor(m/60)+'h '+String(m%60).padStart(2,'0')+'m';
  }

  let W, H, PAD_L, PAD_R, PAD_T, PAD_B, chartW, chartH;

  function setup(){
    W = canvas.offsetWidth || 680;
    H = Math.round(W * 0.48);
    canvas.width = W;
    canvas.height = H;
    PAD_L = 42; PAD_R = 12; PAD_T = 18; PAD_B = 28;
    chartW = W - PAD_L - PAD_R;
    chartH = H - PAD_T - PAD_B;
  }

  function xOf(doy){ return PAD_L + ((doy-1)/(DAYS-1))*chartW; }
  function yOf(h){
    return PAD_T + (1-(h-0)/24)*chartH;
  }

  function drawBand(topAcc, botAcc, color){
    ctx.beginPath();
    ctx.moveTo(xOf(data[0].doy), yOf(topAcc(data[0])));
    for(let i=1;i<data.length;i++) ctx.lineTo(xOf(data[i].doy), yOf(topAcc(data[i])));
    for(let i=data.length-1;i>=0;i--) ctx.lineTo(xOf(data[i].doy), yOf(botAcc(data[i])));
    ctx.closePath();
    ctx.fillStyle = color;
    ctx.fill();
  }

  function drawLine(accessor, color, dash){
    ctx.beginPath();
    ctx.setLineDash(dash||[]);
    ctx.strokeStyle = color;
    ctx.lineWidth = 1;
    for(let i=0;i<data.length;i++){
      const x = xOf(data[i].doy), y = yOf(accessor(data[i]));
      i===0 ? ctx.moveTo(x,y) : ctx.lineTo(x,y);
    }
    ctx.stroke();
    ctx.setLineDash([]);
  }

  function draw(){
    setup();
    ctx.clearRect(0,0,W,H);

    ctx.fillStyle = '#0e1628';
    ctx.fillRect(PAD_L, PAD_T, chartW, chartH);

    drawBand(d=>d.dawnNaut,  d=>d.duskNaut,  '#1e2e5a');
    drawBand(d=>d.dawnCivil, d=>d.duskCivil, '#5a3a6e');
    drawBand(d=>d.rise,      d=>d.set,       '#b8703a');

    const gSun = ctx.createLinearGradient(0, yOf(22), 0, yOf(6));
    gSun.addColorStop(0,'rgba(200,100,50,0.0)');
    gSun.addColorStop(0.5,'rgba(220,130,60,0.25)');
    gSun.addColorStop(1,'rgba(200,100,50,0.0)');
    ctx.fillStyle = gSun;
    ctx.fillRect(PAD_L, PAD_T, chartW, chartH);

    [89, 296].forEach(doy=>{
      ctx.beginPath();
      ctx.strokeStyle='rgba(255,255,255,0.12)';
      ctx.lineWidth=0.5;
      ctx.setLineDash([3,4]);
      ctx.moveTo(xOf(doy), PAD_T);
      ctx.lineTo(xOf(doy), PAD_T+chartH);
      ctx.stroke();
      ctx.setLineDash([]);
    });

    drawLine(d=>d.noon,'rgba(255,220,60,0.55)',[4,4]);

    ctx.textAlign='right';
    ctx.font=`10px var(--font-sans,-apple-system,sans-serif)`;
    [6,8,10,12,14,16,18,20,22].forEach(h=>{
      const y = yOf(h);
      ctx.beginPath();
      ctx.strokeStyle='rgba(255,255,255,0.07)';
      ctx.lineWidth=0.5;
      ctx.moveTo(PAD_L,y); ctx.lineTo(PAD_L+chartW,y);
      ctx.stroke();
      ctx.fillStyle='rgba(200,210,240,0.6)';
      ctx.fillText(h+'h', PAD_L-4, y+4);
    });

    ctx.textAlign='center';
    ctx.fillStyle='rgba(200,210,240,0.7)';
    ctx.font=`10px var(--font-sans,-apple-system,sans-serif)`;
    MONTH_DOY.forEach((doy,i)=>{
      const x = xOf(doy+14);
      ctx.fillText(MONTHS[i], x, H-8);
      ctx.beginPath();
      ctx.strokeStyle='rgba(255,255,255,0.07)';
      ctx.lineWidth=0.5;
      ctx.moveTo(xOf(doy), PAD_T);
      ctx.lineTo(xOf(doy), PAD_T+chartH);
      ctx.stroke();
    });

    const now = new Date();
    const todayDoy = Math.floor((now - new Date(now.getFullYear(),0,0))/86400000);
    if(todayDoy>=1 && todayDoy<=365){
      const tx = xOf(todayDoy);
      ctx.beginPath();
      ctx.strokeStyle='rgba(255,255,255,0.7)';
      ctx.lineWidth=1;
      ctx.moveTo(tx,PAD_T); ctx.lineTo(tx,PAD_T+chartH);
      ctx.stroke();
      ctx.fillStyle='rgba(255,255,255,0.85)';
      ctx.font=`bold 9px var(--font-sans,-apple-system,sans-serif)`;
      ctx.textAlign='center';
      ctx.fillText('hoy', tx, PAD_T+10);
    }

    ctx.strokeStyle='rgba(255,255,255,0.06)';
    ctx.lineWidth=0.5;
    ctx.strokeRect(PAD_L,PAD_T,chartW,chartH);
  }

  draw();

  canvas.addEventListener('mousemove', e=>{
    const rect = canvas.getBoundingClientRect();
    const mx = (e.clientX - rect.left) * (canvas.width / rect.width);
    const my = (e.clientY - rect.top) * (canvas.height / rect.height);
    if(mx < PAD_L || mx > PAD_L+chartW || my < PAD_T || my > PAD_T+chartH){
      tip.style.display='none'; return;
    }
    const doy = Math.round(1 + ((mx-PAD_L)/chartW)*(DAYS-1));
    const d = data[Math.max(0,Math.min(DAYS-1,doy-1))];
    const durH = d.set - d.rise;
    tip.innerHTML =
      `<strong>${doyToDate(d.doy)}</strong><br>` +
      `Amanecer: ${fmt(d.rise)}<br>` +
      `Mediod\u00eda: ${fmt(d.noon)}<br>` +
      `Atardecer: ${fmt(d.set)}<br>` +
      `Luz solar: <strong>${fmtDur(durH)}</strong><br>` +
      `Horario: UTC+${d.offset}`;
    tip.style.display='block';
    const tipW = tip.offsetWidth;
    let lx = e.clientX - rect.left + 14;
    if(lx + tipW > rect.width - 8) lx = e.clientX - rect.left - tipW - 14;
    tip.style.left = lx+'px';
    tip.style.top = (e.clientY - rect.top - 20)+'px';
  });
  canvas.addEventListener('mouseleave', ()=>{ tip.style.display='none'; });

  window.addEventListener('resize', draw);
})();
</script>
